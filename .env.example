# Copy this file to .env, or just use the ⚙ settings screen in the app (it writes this file for you).
# Without any AI settings, Wortweg runs in offline mode. Details: docs/CONFIGURATION.md

# gemini | anthropic | openai | openrouter | groq | mistral | deepseek | ollama | lmstudio | custom | none
AI_PROVIDER=gemini

# Keys are stored per provider; several keys may be comma-separated.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# CUSTOM_API_KEY=

# Main model (Gemini and Claude have defaults) and models to try when it is busy.
# AI_MODEL=
# AI_FALLBACK_MODELS=
# Only for AI_PROVIDER=custom (any OpenAI-compatible API):
# AI_BASE_URL=https://example.com/v1

# --- Server ---
# PORT=4173
# HOST=127.0.0.1        # 0.0.0.0 makes it reachable from your phone on the same Wi-Fi
# IDLE_MINUTES=15       # stop the server after this long without requests; 0 = never
