# Copy this file to .env and fill in a key. Without a key, Wortweg runs in offline mode.

# --- Google Gemini (free tier works) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra keys, comma-separated. Free-tier quota is per Google Cloud project,
# so extra keys only help if each comes from a different project.
# GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is rate-limited or overloaded:
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# low | medium | high | default (model's own setting)
# GEMINI_THINKING=low

# --- Any OpenAI-compatible API instead (OpenAI, OpenRouter, Groq, Ollama, LM Studio ...) ---
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=

# --- Server ---
# PORT=4173
# HOST=127.0.0.1        # 0.0.0.0 makes it reachable from your phone on the same Wi-Fi
# IDLE_MINUTES=15       # stop the server after this long without requests; 0 = never
